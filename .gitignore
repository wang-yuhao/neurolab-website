# =============================================================================
# NeuroLab Website .gitignore
# =============================================================================

# CRITICAL: Never commit secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.p12

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
.env/
pip-log.txt
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Node / Frontend
node_modules/
.npm
.yarn/
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# SSL certificates (mounted from host)
/etc/letsencrypt/
/var/www/certbot/

# MongoDB data (volume)
mongo_data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
