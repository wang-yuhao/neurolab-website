# =============================================================================
# NeuroLab Website — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# This file (.env.example) is safe to commit — it contains no real secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# DOMAIN & ENVIRONMENT
# -----------------------------------------------------------------------------

# The domain where this site is deployed (no trailing slash)
DOMAIN=synaping.com

# Environment: development | production
ENV=production


# -----------------------------------------------------------------------------
# MONGODB
# -----------------------------------------------------------------------------

# Root admin credentials for the MongoDB container
# Use a strong random password in production!
MONGO_USER=neurolab_admin
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Database name (used inside the app)
MONGO_DB=neurolab

# Full connection URL — auto-built from above in docker-compose, but you can
# override it here if you use an external MongoDB (e.g. MongoDB Atlas).
# Leave blank to let docker-compose construct it automatically.
# MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/neurolab


# -----------------------------------------------------------------------------
# BACKEND (FastAPI)
# -----------------------------------------------------------------------------

# Secret key for signing tokens / sessions — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY

# Allowed CORS origins (comma-separated, no spaces)
# In production set this to your real domain only
CORS_ORIGINS=https://synaping.com,https://www.synaping.com

# Backend port (internal container port; exposed via Nginx in prod)
BACKEND_PORT=8000

# Number of Uvicorn worker processes (production: 2-4)
WORKERS=2


# -----------------------------------------------------------------------------
# FRONTEND (React / Vite)
# -----------------------------------------------------------------------------

# URL the browser uses to reach the API.
# Development: http://localhost:8000
# Production:  https://synaping.com  (Nginx proxies /api/* to backend)
VITE_API_URL=https://synaping.com

# Site metadata (used in <meta> tags)
VITE_SITE_NAME=NeuroLab
VITE_SITE_URL=https://synaping.com


# -----------------------------------------------------------------------------
# NGINX / SSL (production only)
# -----------------------------------------------------------------------------

# Email for Let's Encrypt certificate notifications
SSL_EMAIL=admin@synaping.com

# Set to 1 to enable HTTP→HTTPS redirect (requires SSL certs to be present)
SSL_ENABLED=1


# -----------------------------------------------------------------------------
# EMAIL / SMTP (optional — for contact form notifications)
# -----------------------------------------------------------------------------

# Set these if you want the contact form to send email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=your_app_password
# CONTACT_EMAIL_TO=lab@synaping.com


# -----------------------------------------------------------------------------
# RATE LIMITING (optional)
# -----------------------------------------------------------------------------

# Max contact form submissions per hour per IP
# RATE_LIMIT_CONTACT=10
